jogo2 <- function() {
mario <- 0
luigi <- 0
acc <- 0
while(mario!= 6 && luigi != 6) {
dadoj <- sample(x = 1:6, size = 1, replace = TRUE)
if(acc%%2 == 0) {
mario <- dadoj
}
else {
luigi <- dadoj
}
acc <- acc + 1
}
return(acc)
}
