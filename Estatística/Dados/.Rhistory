passeio <- function(L)  {
while(L == 0 || L == 20) {
moeda <- sample(x = 1:2, size = 1, replace = FALSE)
if(moeda == 1) {       #coroa = 1 e cara = 2
L <- L - 1
}
else {
L <- L + 1
}
}
if (L == 0) {
return (0)
}
else {
return (1)
}
}
