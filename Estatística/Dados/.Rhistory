lancamentos <- function(number) {
result <- 0
times <- 0
while(result <= 1) {
dado <- sample(x = 1:6, size = 1)
if (dado == number) {
result <- result + 1
}
times <- times + 1
}
return(times)
}
lancamentos(4)
lancamentos(4)
lancamentos(4)
lancamentos(4)
lancamentos(4)
