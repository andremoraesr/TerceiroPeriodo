sorteios <- c()
for(j in 1:100000) {
sorteio <- sample(x = 1:60, size = 6, replace = FALSE)
sorteios[j] <- sum(bilhete %in% sorteio)          #quantidade de acertos
}
sorteios
table(sorteios)            #tabela de frequencia
barplot(table(sorteios))   #grafico de barras da tabela de frequencia
