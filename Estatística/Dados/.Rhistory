titanic <- read.csv(file = "titanic.csv", header = TRUE, sep = ",")    #ler arquivo de dados e colocar num objeto
setwd("~/GitHub/Terceiro Periodo/Estatística/Dados")
titanic <- read.csv(file = "titanic.csv", header = TRUE, sep = ",")    #ler arquivo de dados e colocar num objeto
str(titanic)              #ver estrutura na tabela
View(titanic)
View(titanic)
titanic$Name[3]
titanic$Name[4]
titanic[titanic$Sex == "female"]
titanic[titanic$Sex == "female",]
titanic_first <- titanic[titanic$Pclass == 1]
titanic_first <- titanic[titanic$Pclass == 1,]
titanic_second <- titanic[titanic$Pclass == 2,]
titanic_third <- titanic[titanic$Pclass == 3,]
titanic_first
sum(titanic_first$Survived == 1)/216
sum(titanic_second$Survived == 1)/184
sum(titanic_third$Survived == 1)/491
table(titanic_first$Survived)
prop.table(table(titanic_first$Survived))
table(titanic_second$Survived)    #tabela quantos morreram e sobreviveram 2 classe
prop.table(table(titanic_second$Survived))        #tabela proporcao quantos morr. e sobrev. 2 classe
table(titanic_third$Survived)    #tabela quantos morreram e sobreviveram 3 classe
prop.table(table(titanic_third$Survived))        #tabela proporcao quantos morr. e sobrev. 3 classe
mean(titanic_third$Survived == 1 && titanic_third$Sex == "male")
mean(titanic_third$Survived == 1 & titanic_third$Sex == "male")
mean(titanic_third$Survived == 1 & titanic_third$Sex == "female")
table(titanic_third$Survived, titanic_third$Sex)
table(titanic_second$Survived, titanic_second$Sex)
table(titanic_first$Survived, titanic_first$Sex)
mean(titanic$Survived == 1 & titanic$Fare > 30)
mean(titanic$Survived == 1 & titanic$Fare < 30)
mean(titanic$Survived == 1 & titanic$Fare < 10)
mean(titanic$Survived == 1 & titanic$Fare < 100)
mean(titanic$Survived == 1 & titanic$Fare < 200)
mean(titanic$Survived == 1 & titanic$Fare < 1000)
homens <- titanic[titanic$Sex == "male",]
prop.table(table(homens$Survived, homens$Pclass), margin = 2)
summary(titanic)
