passeio <- function(L)  {
while(L /= 0 || L /= 20) {
while(L != 0 || L != 20) {
moeda <- sample(x = 1:2, size = 1, replace = FALSE)
if(moeda == 1) {       #coroa = 1 e cara = 2
L <- L - 1
}
else {
L <- L + 1
}
}
passeio <- function(L)  {
while(L != 0 || L != 20) {
moeda <- sample(x = 1:2, size = 1, replace = FALSE)
if(moeda == 1) {       #coroa = 1 e cara = 2
L <- L - 1
}
else {
L <- L + 1
}
}
if (L == 0) {
return (0)
}
else {
return (1)
}
}
passeio(10)
passeio <- function(L)  {
while(L > 0 && L < 20) {
moeda <- sample(x = 1:2, size = 1, replace = FALSE)
if(moeda == 1) {       #coroa = 1 e cara = 2
L <- L - 1
}
else {
L <- L + 1
}
}
if (L == 0) {
return (0)
}
else {
return (1)
}
}
passeio(10)
passeio(10)
passeio(10)
passeio(12)
passeio(2)
prop <- function(L) {
resultado <- c()
for(i in 1:10000) {
resultado[i] <- passeio(L)
}
return(mean(resultado))
}
prop(10)
