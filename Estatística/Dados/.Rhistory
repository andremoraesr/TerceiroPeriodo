setwd("~/GitHub/Terceiro Periodo/Estatística/Dados")
pinguins <-  read.csv(file = "penguins.csv", header = TRUE, sep = ',')
str(pinguins)
library(ggplot2)
library(dplyr)
pinguis <- pinguins |>
mutate(species <- as.factor(species), island <- as.factor(island), sex = as.factor(sex))
pinguins <- pinguins |>
mutate(species <- as.factor(species), island <- as.factor(island), sex = as.factor(sex))
View(pinguis)
rm(pinguis)
View(pinguins)
pinguins <- filter(pinguins, sex == "")
pinguins <-  read.csv(file = "penguins.csv", header = TRUE, sep = ',')
pinguins <- filter(pinguins, sex \= "")
pinguins <- filter(pinguins, sex != "")
pinguins <-  read.csv(file = "penguins.csv", header = TRUE, sep = ',')
pinguins <- pinguins |>
filter(pinguins, sex != "")
pinguins <- pinguins |>
filter(sex != "")
ggplot(data = pinguins, mapping = aes(x = island, fill = species)) + geom_bar() + facet_wrap(~sex)
ggplot(data = pinguis, mapping = aes(x = species)) + geom_bar()
ggplot(data = pinguins, mapping = aes(x = species)) + geom_bar()
ggplot(data = pinguins, mapping = aes(x = species)) + geom_bar() + facet_wrap(~sex)
ggplot(data = pinguins, mapping = aes(x = species, fill = sex)) + geom_bar()
ggplot(data = pinguins, mapping = aes(x = sex)) + geom_bar() + facet_wrap(~species)
ggplot(data = pinguins, mapping = aes(x = sex)) + geom_bar() + facet_wrap(~species) + theme_minimal()
ggplot(data = pinguins, mapping = aes(x = island, fill = species)) + geom_bar() + theme_minimal()
ggplot(data = pinguins, mapping = aes(body_mass_g)) + geom_histogram()
ggplot(data = pinguins, mapping = aes(body_mass_g)) + geom_histogram(fill = "steelblue", col = "white")
ggplot(data = pinguins, mapping = aes(bill_length_mm)) + geom_histogram(fill = "steelblue", col = "white")
ggplot(data = pinguins, mapping = aes(body_mass_g)) + facet_wrap(~species) + geom_histogram(fill = "steelblue", col = "white")
ggplot(data = pinguins, mapping = aes(body_mass_g)) + facet_wrap(~sex) + geom_histogram(fill = "steelblue", col = "white")
ggplot(data = pinguins, mapping = aes(body_mass_g)) + facet_wrap(~species) + geom_histogram(fill = "steelblue", col = "white")
ggplot(data = pinguins, mapping = aes(y = body_mass_g)) + geom_boxplot() + theme_minimal()
ggplot(data = pinguins, mapping = aes(y = body_mass_g)) + geom_boxplot() + theme_minimal() + facet_wrap(~species)
ggplot(data = pinguins, mapping = aes(y = flipper_length_mm)) + geom_boxplot() + theme_minimal()
