#Questão 9
#Letra (a)
passeio2 <- function(passos) {
possibilidades <- c("L", "R", "U", "D")
posicao <- c(0,0)
for(i in 1:8) {
dado <- sample(x = possibilidades, size = 1)
if(dado == "L") {
posicao[1] <- posicao[1]-1
}
if(dado == "R") {
posicao[1] <- posicao[1]+1
}
if(dado == "U") {
posicao[2] <- posicao[2]+1
}
if(dado == "D") {
posicao[2] <- posicao[2]-1
}
}
return (posicao)
}
passeio2(8)
propVezes <- function() {
origem <- c(0,0)
resultado <- c()
for(i in 1:1000) {
if(passeios(8) == origem) {
resultado[i] <- 1
}
else {
resultado[i] <- 0
}
}
return(mean(resultado))
}
